# No secrets in repo. Copy to .env for local run.
SYGNAL_MCP_URL=https://api.trysygnal.com/mcp
SYGNAL_API_KEY=put_your_key_here_without_committing
PORT=3000
# Mock mode for video/offline judging when Sygnal list_signals is unavailable:
# true = use fixtures/signals.json, false = call live MCP
MOCK_SIGNALS=true
# Cloudflare Workers AI (local Express /api/speech proxy only — gitignored).
# Deployed worker/speech.ts uses AI binding instead, no token needed.
CLOUDFLARE_ACCOUNT_ID=put_account_id_here_without_committing
CLOUDFLARE_API_TOKEN=put_api_token_here_without_committing
# NVIDIA NIM hosted TTS (free trial, no card — key from build.nvidia.com).
# NOTE 2026-09-29: the hosted trial model list currently exposes NO speech/TTS
# models for a standard key (81 text/vision/embed models only; Magpie/Chatterbox
# are request-gated or deprecated). Kept as optional first provider if NVIDIA
# opens TTS on your key — harmless otherwise (404s fast, falls through).
NVIDIA_API_KEY=put_nvidia_key_here_without_committing
NVIDIA_TTS_MODEL=nvidia/magpie-tts-multilingual
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
# Public URL of deployed voice worker (set in UI "Voice via Cloudflare" field)
VOICE_WORKER_URL=https://alexa-signal-voice.mayorjoshua51.workers.dev
